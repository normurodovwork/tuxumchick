{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user accounts (admin or deliverer)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID matching UID or custom unique username" },
        "username": { "type": "string", "description": "Username / Phone used for login" },
        "name": { "type": "string", "description": "Full name of the user" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "password": { "type": "string", "description": "Hashed or encrypted password" },
        "role": { "type": "string", "enum": ["admin", "deliverer"], "description": "User role" },
        "status": { "type": "string", "enum": ["active", "blocked"], "description": "User account status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "username", "name", "phone", "password", "role", "status"]
    },
    "Shop": {
      "title": "Shop",
      "description": "B2B client shops purchasing eggs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Generated document ID" },
        "name": { "type": "string", "description": "Store name" },
        "contactPerson": { "type": "string", "description": "Contact person name" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "address": { "type": "string", "description": "Physical address / landmark" },
        "note": { "type": "string", "description": "General custom notes" },
        "status": { "type": "string", "enum": ["active", "archive"], "description": "Shop status" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "status"]
    },
    "EggType": {
      "title": "EggType",
      "description": "Egg categories available for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Category ID" },
        "nameRu": { "type": "string", "description": "Name in Russian" },
        "nameUz": { "type": "string", "description": "Name in Uzbek" },
        "pricePerTray": { "type": "number", "description": "Price per tray (30 eggs)" },
        "status": { "type": "string", "enum": ["active", "archive"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameRu", "nameUz", "pricePerTray", "status"]
    },
    "PriceHistory": {
      "title": "PriceHistory",
      "description": "Historical record of egg prices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eggTypeId": { "type": "string" },
        "pricePerTray": { "type": "number" },
        "changedAt": { "type": "string", "format": "date-time" },
        "changedBy": { "type": "string" }
      },
      "required": ["id", "eggTypeId", "pricePerTray", "changedAt", "changedBy"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A wholesale sale operation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "delivererId": { "type": "string" },
        "date": { "type": "string", "format": "date-time", "description": "Date of delivery (can be retroactive)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "items": {
          "type": "array",
          "description": "Array of sold egg categories and quantities"
        },
        "totalAmount": { "type": "number" },
        "amountReceived": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "transfer", "none"] },
        "debtAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "cancelled"] },
        "cancellationReason": { "type": "string" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "cancelledBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "shopId", "delivererId", "date", "createdAt", "items", "totalAmount", "amountReceived", "paymentMethod", "debtAmount", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Repayment of debt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "delivererId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "transfer"] },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "cancelled"] },
        "cancellationReason": { "type": "string" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "cancelledBy": { "type": "string" }
      },
      "required": ["id", "shopId", "delivererId", "date", "createdAt", "amount", "paymentMethod", "status"]
    },
    "Adjustment": {
      "title": "Adjustment",
      "description": "Manual balance adjustments by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "amount": { "type": "number", "description": "Positive adds to debt, negative subtracts" },
        "reason": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "shopId", "amount", "reason", "createdBy", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Logs of user edits, creations, and security actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "action", "targetId", "details", "timestamp"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "traysPerBox": { "type": "number" },
        "eggsPerTray": { "type": "number" },
        "oldDebtThresholdDays": { "type": "number" }
      },
      "required": ["traysPerBox", "eggsPerTray", "oldDebtThresholdDays"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Users of the system"
    },
    "shops": {
      "schema": "Shop",
      "description": "B2B retail shops"
    },
    "egg_types": {
      "schema": "EggType",
      "description": "Categories of eggs and their current prices"
    },
    "price_history": {
      "schema": "PriceHistory",
      "description": "History of price changes for eggs"
    },
    "sales": {
      "schema": "Sale",
      "description": "Wholesale delivery/sales transactions"
    },
    "payments": {
      "schema": "Payment",
      "description": "Collections of cash or wire payments for debts"
    },
    "adjustments": {
      "schema": "Adjustment",
      "description": "Admin manual balance corrections"
    },
    "activity_log": {
      "schema": "ActivityLog",
      "description": "Chronological action logs for auditing"
    },
    "settings": {
      "schema": "Settings",
      "description": "Single document holding global configurations"
    }
  }
}
