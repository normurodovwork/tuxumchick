# NEXT_PUBLIC_API_URL: адрес REST API Django-бэкенда (backend/).
# Инлайнится в сборку фронтенда, поэтому должен быть адресом бэкенда,
# видимым из браузера пользователя. По умолчанию — http://localhost:8000/api
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# NEXT_PUBLIC_YANDEX_MAPS_KEY: ключ JS API Яндекс.Карт (необязательно).
# Без ключа выбор локации работает через ручной ввод координат и ссылку
# «Открыть Яндекс.Карты»; с ключом включается интерактивная карта с маркером.
# Получить: https://developer.tech.yandex.ru/ (JavaScript API и HTTP Геокодер).
NEXT_PUBLIC_YANDEX_MAPS_KEY=""
