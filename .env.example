# Переменные для docker-compose. Скопируйте в .env и при необходимости измените.

# PostgreSQL
POSTGRES_DB=tuxumchick
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Загрузить демо-данные при старте (admin/admin123, доставщики .../123)
SEED_DEMO=true

# CORS
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Порты на хосте
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Адрес API для браузера (инлайнится в сборку фронтенда).
# Должен указывать на хост-порт бэкенда.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
