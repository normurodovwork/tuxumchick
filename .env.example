# Переменные для docker-compose. Скопируйте в .env и ОБЯЗАТЕЛЬНО измените секреты перед деплоем.
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=tuxumchick
POSTGRES_USER=postgres
# ВАЖНО: задайте надёжный пароль для продакшена.
POSTGRES_PASSWORD=change-me-strong-password

# --- Django ---
# ВАЖНО: сгенерируйте уникальный ключ, напр.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# В продакшене оставляйте False. True — только для локальной отладки.
DJANGO_DEBUG=False
# Список доменов через запятую, напр. tuxumchick.example.com
DJANGO_ALLOWED_HOSTS=*

# Загрузка демо-данных при старте (админ/доставщики с тестовыми паролями).
# В ПРОДАКШЕНЕ держите false; первого админа создайте через createsuperuser:
#   docker compose exec backend python manage.py createsuperuser
SEED_DEMO=false

# --- CORS ---
# Разрешить любые origin — только для разработки. В проде оставляйте False.
CORS_ALLOW_ALL=False
# Домен(ы) фронтенда через запятую, напр. https://tuxumchick.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- HTTPS-безопасность (для продакшена за TLS-прокси) ---
# True включает SSL-редирект, secure-cookies и HSTS. Оставляйте False для локального HTTP.
DJANGO_SECURE_SSL=False
# Доверенные домены для CSRF при DEBUG=False, через запятую, со схемой https://
CSRF_TRUSTED_ORIGINS=

# --- Порты на хосте ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Адрес API, видимый из браузера (инлайнится в сборку фронтенда).
# Должен указывать на публичный адрес бэкенда, напр. https://api.tuxumchick.example.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
